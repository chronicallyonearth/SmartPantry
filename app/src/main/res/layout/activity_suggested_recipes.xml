<?xml version="1.0" encoding="utf-8"?>
<!--main container-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cherry_700"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar-->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SmartPantry.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Suggested Recipes" />

    <!--Content stack container-->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cherry_50">

        <!--Dynamic scrollable list-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRecipes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp" />

        <!--hidden by default empty state label-->
        <TextView
            android:id="@+id/textEmptyRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/cherry_700"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>