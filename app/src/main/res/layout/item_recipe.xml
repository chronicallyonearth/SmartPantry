<?xml version="1.0" encoding="utf-8"?>

<!--Single Card Container for individual recipe card item-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cherry_200"
    app:strokeWidth="1dp">

    <!--content layout-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--recipe title-->
        <TextView
            android:id="@+id/textRecipeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cherry_900"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!--recipe extras-->
        <TextView
            android:id="@+id/textRecipeMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/cherry_600"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>